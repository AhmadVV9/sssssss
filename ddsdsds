-- ==================== TRANSPARENT BUTTON STYLE ====================
local function applyTransparentStyle(btnData)
    if not btnData.borderFrame or not btnData.button then return end
    if transparentButtons then
        btnData.borderFrame.BackgroundColor3 = Color3.fromHex("#7a1fa2")
        btnData.borderFrame.BackgroundTransparency = 0.7
        btnData.button.BackgroundColor3 = Color3.fromHex("#2d0047")
        btnData.button.BackgroundTransparency = 0.6
        if btnData.borderGradient then
            btnData.borderGradient.Transparency = NumberSequence.new(0.3)
        end
        if btnData.btnGradient then
            btnData.btnGradient.Transparency = NumberSequence.new(0.4)
        end
        if btnData.stroke then
            btnData.stroke.Transparency = 0.7
        end
    else
        btnData.borderFrame.BackgroundColor3 = Color3.fromHex("#7a1fa2")
        btnData.borderFrame.BackgroundTransparency = 0
        btnData.button.BackgroundColor3 = Color3.fromHex("#2d0047")
        btnData.button.BackgroundTransparency = 0
        if btnData.borderGradient then
            btnData.borderGradient.Transparency = NumberSequence.new(0)
        end
        if btnData.btnGradient then
            btnData.btnGradient.Transparency = NumberSequence.new(0)
        end
        if btnData.stroke then
            btnData.stroke.Transparency = 0
        end
    end
end

local function updateAllButtonsStyle()
    for _, btn in pairs(activeButtons) do
        applyTransparentStyle(btn)
    end
end

