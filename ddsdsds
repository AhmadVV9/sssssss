    local function updateShootInput(input)
        if shootButtonLocked then return end
        local delta = input.Position - shootDragStart
        shootBorderFrame.Position = UDim2.new(
            shootStartPos.X.Scale,
            shootStartPos.X.Offset + delta.X,
            shootStartPos.Y.Scale,
            shootStartPos.Y.Offset + delta.Y
        )
    end

    shootButton.InputBegan:Connect(function(input)
        if shootButtonLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            shootDragging = true
            shootDragStart = input.Position
            shootStartPos = shootBorderFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    shootDragging = false
                end
            end)
        end
    end)

    shootButton.InputChanged:Connect(function(input)
        if shootButtonLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            shootDragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if shootButtonLocked then return end
        if shootDragging and input == shootDragInput then
            updateShootInput(input)
        end
    end)

    -- Hover effects
    shootButton.MouseEnter:Connect(function()
        if not isMobile then
            borderGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHex("#5b0f8c")),
                ColorSequenceKeypoint.new(1, Color3.fromHex("#ce93d8"))
            })
            btnGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHex("#4a0072")),
                ColorSequenceKeypoint.new(1, Color3.fromHex("#8e24aa"))
            })
            stroke.Color = Color3.fromHex("#e1bee7")
        end
    end)

    shootButton.MouseLeave:Connect(function()
        if not isMobile then
            borderGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHex("#3a005c")),
                ColorSequenceKeypoint.new(1, Color3.fromHex("#ab47bc"))
            })
            btnGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHex("#3a005c")),
                ColorSequenceKeypoint.new(1, Color3.fromHex("#7a1fa2"))
            })
            stroke.Color = Color3.fromHex("#c084fc")
        end
    end)

    -- Click action
    shootButton.MouseButton1Click:Connect(function()
        local murd = findMurderer()
        if not murd then 
            WindUI:Notify({Title = "Error", Content = "No murderer found!", Duration = 2})
            return 
        end
        local gun = Plr.Character:FindFirstChild("Gun")
        if not gun and Plr.Backpack:FindFirstChild("Gun") then
            Plr.Character.Humanoid:EquipTool(Plr.Backpack.Gun)
            task.wait(0.1)
            gun = Plr.Character:FindFirstChild("Gun")
        end
        if gun then
            local pos = getPredictedPosition(murd)
            gun.Shoot:FireServer(CFrame.new(Plr.Character.RightHand.Position), CFrame.new(pos))
            WindUI:Notify({Title = "Error", Content = "No gun equipped!", Duration = 2})
        end
    end)
end

