-- Auto Get Gun
local function autoGetGun()
    local map = nil
    for _, v in ipairs(workspace:GetChildren()) do
        if v:FindFirstChild("CoinContainer") then
            map = v
            break
        end
    end
    if not map then return end

    local gunDrop = map:FindFirstChild("GunDrop")
    if not gunDrop then return end

    local previousCFrame = HumanoidRootPart.CFrame
    HumanoidRootPart.CFrame = gunDrop.CFrame + Vector3.new(0, 5, 0)

    local success = Plr.Backpack.ChildAdded:Wait(2)
    if success then
        task.wait(0.3)
        HumanoidRootPart.CFrame = previousCFrame
        WindUI:Notify({ Title = "Auto Get Gun", Content = "Successfully picked up the dropped gun!", Duration = 3, Icon = "check" })
    end
end

-- ==================== NO CLIP & CLIENT INVISIBLE ====================
local function updateNoClip(state)
    if not Character then return end
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

local function updateInvisible(state)
    if not Character then return end
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = state and 1 or 0
        end
    end
    for _, obj in ipairs(Character:GetChildren()) do
        if obj:IsA("Accessory") then
            for _, part in ipairs(obj:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = state and 1 or 0
                end
            end
        end
    end
    if Humanoid then
        for _, child in ipairs(Humanoid:GetChildren()) do
            if child:IsA("Sound") then
                child.Volume = state and 0 or 1
            end
        end
    end
end

