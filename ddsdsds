local EspSection = Window:Section({ Title = "ESP", Icon = "eye", Opened = false })
local EspTab = EspSection:Tab({ Title = "Main", Icon = "pin", Locked = false })

local esp_enabled = false
local hitbox_enabled = false
local tracers_enabled = false
local names_enabled = false
local lines = {}
local nameBillboards = {}

local InnocentColor = Color3.fromRGB(0, 170, 0)
local SheriffColor = Color3.fromRGB(0, 0, 255)
local MurdererColor = Color3.fromRGB(255, 0, 0)

local function getRoleColor(player)
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return MurdererColor
    elseif player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return SheriffColor
    end
    return InnocentColor
end

local DrawingAvailable = pcall(function() return Drawing.new end)

local function clearTracers()
    if not DrawingAvailable then return end
    for _, line in pairs(lines) do
        if line then line:Remove() end
    end
    table.clear(lines)
end

local function clearNameBillboards()
    for _, bb in pairs(nameBillboards) do
        if bb then bb:Destroy() end
    end
    table.clear(nameBillboards)
end

local function UpdateVisuals()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Plr and player.Character then
            local char = player.Character
            local highlight = char:FindFirstChild("EspHighlight")
            local color = getRoleColor(player)

            if esp_enabled or hitbox_enabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "EspHighlight"
                    highlight.Parent = char
                end
                highlight.FillColor = color
                highlight.FillTransparency = esp_enabled and 0.5 or 1
                highlight.OutlineTransparency = hitbox_enabled and 0 or 1
                highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
            else
                if highlight then highlight:Destroy() end
            end

            local head = char:FindFirstChild("Head")
            if head then
                local existing = head:FindFirstChild("NameTag")
                if names_enabled then
                    if not existing then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "NameTag"
                        billboard.Size = UDim2.new(0, 200, 0, 50)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = head

                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.Text = player.Name
                        label.TextColor3 = color
                        label.TextScaled = true
                        label.Font = Enum.Font.SourceSansBold
                        label.Parent = billboard

                        nameBillboards[player] = billboard
                    end
                else
                    if existing then existing:Destroy() end
                end
            end
        end
    end

    clearTracers()
    if tracers_enabled and DrawingAvailable then
        local camera = workspace.CurrentCamera
        local screenTopCenter = Vector2.new(camera.ViewportSize.X / 2, 0)

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Plr and player.Character then
                local targetHead = player.Character:FindFirstChild("Head")
                if targetHead then
                    local targetScreen, onScreen = camera:WorldToScreenPoint(targetHead.Position)
                    if onScreen then
                        local line = Drawing.new("Line")
                        line.From = screenTopCenter
                        line.To = Vector2.new(targetScreen.X, targetScreen.Y)
                        line.Color = getRoleColor(player)
                        line.Thickness = 1.5
                        line.Transparency = 0.5
                        line.Visible = true
                        table.insert(lines, line)
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if tracers_enabled then
        UpdateVisuals()
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if esp_enabled or hitbox_enabled or names_enabled then
            UpdateVisuals()
        else
            clearTracers()
            clearNameBillboards()
        end
    end
end)

